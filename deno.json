{
   "lock": false,
   "version": "0.28.11",
   "lint": {
      "rules": {
         "exclude": ["no-explicit-any", "no-empty"]
      }
   },
   "imports": {
      "@sholvoir/dict-server/": "https://raw.githubusercontent.com/sholvoir/dict-server/d963b5ee1f43d3c998b585b91632c83d1dc5578d/src/",
      "@sholvoir/generic": "jsr:@sholvoir/generic@^0.4.9",
      "@std/crypto": "jsr:@std/crypto@^1.1.0",
      "hono": "jsr:@hono/hono@^4.13.13",
      "mongodb": "npm:mongodb@^7.7.0"
   },
   "minimumDependencyAge": "0",
   "tasks": {
      "build": "deno bundle --check --minify src/main.ts >> dest/main.js",
      "start": "deno run -A --env --watch=src/ src/main.ts"
